target/
.idea/
# Python bytecode cache from repo tooling scripts (e.g. crates/elephc-image/tools/)
__pycache__/
*.pyc
# macOS Finder metadata — never track
.DS_Store
# Internal planning docs (specs/plans) — kept locally, not tracked
docs/superpowers/
# Subagent-driven-development scratch (briefs, reports, review diffs, ledger) — local only
.superpowers/
# Generated archives written to the repo root when the phar-write example
# is run from here instead of its own directory (root-anchored so the
# tracked examples/phar-reader/app.phar fixture is unaffected)
/hello.phar
/note.phar
/oop.phar
/bundle.tar
/bundle.tar.gz
/bundle.tar.bz2

# Native artifacts generated beside the stock web entry point.
/examples/symfony-app/public/index
/examples/symfony-app/public/index.s
/examples/symfony-app/public/index.o
/examples/symfony-app/public/index.map

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Kage repository memory: the verified packets are committed and shared, every
# other entry (indexes, code graph, structural/observation caches, daemon and
# store state, reports) is local and regenerable (run `kage refresh`).
.agent_memory/*
!.agent_memory/packets/
.agent_memory/packets/*
!.agent_memory/packets/*.md
